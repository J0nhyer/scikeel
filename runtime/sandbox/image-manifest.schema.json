{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SciKeel immutable scientific image manifest",
  "type": "object",
  "required": [
    "schema",
    "name",
    "variant",
    "architecture",
    "rootfsSha256",
    "imageDigest",
    "python",
    "uv",
    "baselineLockSha256",
    "toolLockSha256",
    "tools",
    "enabledRuntimes",
    "provenance",
    "fileCount",
    "uncompressedBytes"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "const": "science-v1"
    },
    "variant": {
      "enum": [
        "probe",
        "production"
      ]
    },
    "architecture": {
      "const": "linux/amd64"
    },
    "rootfsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baselineLockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "toolLockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "python": {
      "type": "string",
      "pattern": "^3\\.12\\.\\d+$"
    },
    "uv": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "fileCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "uncompressedBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483648
    },
    "enabledRuntimes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "opencode",
          "codex",
          "claude"
        ]
      }
    },
    "tools": {
      "type": "object",
      "required": [
        "osd",
        "opencode",
        "node",
        "uv",
        "python",
        "git"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "sha256",
          "path"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "repository",
        "commit",
        "workflow"
      ],
      "properties": {
        "repository": {
          "const": "J0nhyer/scikeel"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "workflow": {
          "const": "sandbox-image.yml"
        }
      },
      "additionalProperties": false
    },
    "runnerFiles": {
      "type": "object",
      "required": [
        "opt/scikeel/tools/runner.mjs",
        "opt/scikeel/tools/file-rpc.mjs",
        "opt/scikeel/tools/cli-jobs.mjs",
        "opt/scikeel/tools/project-environment.py"
      ],
      "propertyNames": {
        "enum": [
          "opt/scikeel/tools/runner.mjs",
          "opt/scikeel/tools/file-rpc.mjs",
          "opt/scikeel/tools/cli-jobs.mjs",
          "opt/scikeel/tools/project-environment.py",
          "opt/scikeel/tools/science-environment.mjs",
          "opt/scikeel/tools/collaboration.mjs",
          "opt/scikeel/tools/tool-outcome.mjs"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "testEntryPoint": {
      "const": "/opt/scikeel/tools/probe-entry.mjs"
    },
    "sourceInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "codexRuntime": {
      "type": "object",
      "required": ["integration", "resources"],
      "properties": {
        "integration": {
          "type": "object",
          "required": ["schema", "policy", "upstreamVersion", "upstreamCommit", "patchSha256", "testPatchSha256", "rustVersion", "lockFormat", "upstreamLockSha256", "workspaceLockSha256", "bwrapSha256", "target", "binarySha256", "source", "version"],
          "properties": {
            "schema": {"const": 1},
            "policy": {"const": "required-effect-guard-v1"},
            "upstreamVersion": {"const": "0.157.1"},
            "upstreamCommit": {"const": "36650394c5b38c2990ccf2a3457165ca3e9d9726"},
            "patchSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "testPatchSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "rustVersion": {"const": "1.95.0"},
            "lockFormat": {"const": "smol-toml@1.9.0"},
            "upstreamLockSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "workspaceLockSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "bwrapSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "target": {"const": "x86_64-unknown-linux-gnu"},
            "binarySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "source": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "version": {"const": "codex-cli 0.157.1"}
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "required": ["opt/scikeel/tools/bin/codex-resources/bwrap", "opt/scikeel/tools/bin/native-integration.json"],
          "properties": {
            "opt/scikeel/tools/bin/codex-resources/bwrap": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "opt/scikeel/tools/bin/native-integration.json": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sessionTitleRuntime": {
      "type": "object",
      "required": [
        "schema",
        "upstreamVersion",
        "upstreamCommit",
        "sourceTree",
        "bunVersion",
        "patchSha256",
        "policy",
        "target",
        "version",
        "binarySha256"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "upstreamVersion": {
          "const": "1.18.32"
        },
        "upstreamCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourceTree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "bunVersion": {
          "const": "1.3.14"
        },
        "patchSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy": {
          "const": "conversation-v1"
        },
        "target": {
          "const": "bun-linux-x64"
        },
        "version": {
          "const": "1.18.32"
        },
        "binarySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "networkRuntime": {
          "type": "object",
          "required": [
            "schema",
            "policy",
            "upstreamCommit",
            "patchSha256",
            "combinedPatchSha256",
            "outcomeSha256"
          ],
          "properties": {
            "schema": {
              "const": 1
            },
            "policy": {
              "const": "call-scope-v1"
            },
            "upstreamCommit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "patchSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "combinedPatchSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "outcomeSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"enabledRuntimes": {"contains": {"const": "codex"}}}},
      "then": {"required": ["codexRuntime"], "properties": {"tools": {"required": ["codex"]}}},
      "else": {"not": {"required": ["codexRuntime"]}}
    },
    {
      "if": {
        "properties": {
          "variant": {
            "const": "production"
          }
        }
      },
      "then": {
        "required": [
          "runnerFiles"
        ],
        "not": {
          "required": [
            "testEntryPoint"
          ]
        }
      }
    }
  ]
}
