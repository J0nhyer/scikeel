COMPOSE_PROJECT_NAME=scikeel
LOCAL_HTTP_PORT=8080
SCIKEEL_PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/

# Container paths and the matching host sources.
PLATFORM_DATA_DIR=/srv/scikeel/data
PLATFORM_WEB_ROOT=/app/apps/desktop/dist
SANDBOX_DATA_DIR=/srv/scikeel/data
SANDBOX_DATA_HOST_DIR=/absolute/path/to/scikeel/.local/data
PLATFORM_SANDBOX_INSTANCES_DIR=/srv/scikeel/data/workers/instances
SANDBOX_INSTANCES_DIR=/srv/scikeel/data/workers/instances
SANDBOX_INSTANCES_HOST_DIR=/absolute/path/to/scikeel/.local/data/workers/instances
PLATFORM_SANDBOX_NATIVE_DIR=/srv/scikeel/data/cli-runtime/users
SANDBOX_NATIVE_DIR=/srv/scikeel/data/cli-runtime/users
SANDBOX_NATIVE_HOST_DIR=/absolute/path/to/scikeel/.local/data/cli-runtime/users
SANDBOX_STATE_DIR=/srv/scikeel/data/.sandbox-state
SANDBOX_STATE_HOST_DIR=/absolute/path/to/scikeel/.local/data/.sandbox-state

# Platform and worker identity.
PLATFORM_HOST=172.30.0.10
PLATFORM_PORT=4790
PLATFORM_UID=1000
PLATFORM_GID=1000
SANDBOX_WORKER_UID=1000
SANDBOX_WORKER_GID=1000
SANDBOX_CONTROL_GID=1000
FRONT_SUBNET=172.30.0.0/24
FRONT_PLATFORM_IP=172.30.0.10

# Local login. The bootstrap script fills a generated password.
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=
PLATFORM_SECURE_COOKIES=false

# Managed sandbox.
PLATFORM_MAX_RESIDENTS=1
PLATFORM_CATALOG_MIGRATE=1
PLATFORM_DISABLED_RUNTIMES=codex
PLATFORM_SANDBOX_BACKEND=docker
PLATFORM_SANDBOX_SOCKET=/run/scikeel/sandbox.sock
PLATFORM_SANDBOX_IMAGE_DIGEST=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
PLATFORM_SANDBOX_WORKER_IMAGE_MANIFEST=/etc/scikeel/worker-image.json
PLATFORM_SANDBOX_BROKER_HOST=broker
SANDBOX_PLATFORM_CONTAINER=scikeel-platform
SANDBOX_BACKEND_CONTAINER=scikeel-sandbox-backend
SANDBOX_WORKER_PLATFORM=linux/amd64
SANDBOX_DOCKER_RUNTIME=runc
SANDBOX_WORKER_MEMORY=1073741824
SANDBOX_WORKER_SWAP=1207959552
SANDBOX_WORKER_PIDS=256
SANDBOX_WORKER_CPUS=1
SANDBOX_HEALTH_TIMEOUT_MS=60000
SANDBOX_STOP_TIMEOUT_SECONDS=10

# The model broker secret is ./secrets/model-brokers.json (never commit it).
