+fn scikeel_required_guard_handlers(handlers: &[ConfiguredHandler]) -> bool {
+    let [handler] = handlers else { return false; };
+    handler.event_name == HookEventName::PreToolUse
+        && handler.source == HookSource::System
+        && matches!(&handler.source_path, HandlerSourcePath::Local(path)
+            if path.as_path() == std::path::Path::new("/etc/codex/requirements.toml"))
+        && handler.matcher.is_none()
+        && !handler.builtin
+        && handler.timeout_sec == 5
+        && matches!(&handler.kind, ConfiguredHandlerKind::Command { command, env, r#async: false }
+            if command == "/opt/scikeel/tools/bin/node /opt/scikeel/runtime/required-effect-guard.mjs --guard"
+                && env.is_empty())
+}
