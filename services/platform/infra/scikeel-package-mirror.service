[Unit]
Description=SciKeel disposable public Python package mirror
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/scikeel/package-mirror
ConditionPathExists=/var/lib/scikeel/package-mirror/.nodeinfo

[Service]
User=scikeel-mirror
Group=scikeel-mirror
ExecStart=/usr/lib/scikeel/mirror/bin/devpi-server --serverdir /var/lib/scikeel/package-mirror --host 127.0.0.1 --port 3141 --threads 4
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M
TasksMax=64
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/scikeel/package-mirror
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
TimeoutStopSec=10s
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
