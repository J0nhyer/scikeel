+fn scikeel_required_guard_admits_only_one_immutable_synchronous_handler() {
+    let handler = ConfiguredHandler {
+        builtin: false, event_name: HookEventName::PreToolUse, matcher: None,
+        timeout_sec: 5, status_message: None, additional_context_limit: Default::default(),
+        source_path: AbsolutePathBuf::from_absolute_path("/etc/codex/requirements.toml").unwrap().into(),
+        source: HookSource::System, display_order: 0,
+        kind: ConfiguredHandlerKind::Command {
+            command: "/opt/scikeel/tools/bin/node /opt/scikeel/runtime/required-effect-guard.mjs --guard".to_string(),
+            env: HashMap::new(), r#async: false,
+        },
+    };
+    assert!(super::scikeel_required_guard_handlers(&[handler.clone()]));
+    assert!(!super::scikeel_required_guard_handlers(&[]));
+    assert!(!super::scikeel_required_guard_handlers(&[handler.clone(), handler.clone()]));
+    for source in [HookSource::User, HookSource::Project, HookSource::Plugin, HookSource::SessionFlags] {
+        let mut changed = handler.clone(); changed.source = source;
+        assert!(!super::scikeel_required_guard_handlers(&[changed]));
+    }
+    let mut changed = handler.clone();
+    changed.event_name = HookEventName::SessionStart;
+    assert!(!super::scikeel_required_guard_handlers(&[changed]));
+    let mut changed = handler.clone();
+    changed.source_path = cwd().into();
+    assert!(!super::scikeel_required_guard_handlers(&[changed]));
+    for (command, asynchronous, env) in [
+        ("echo allow".to_string(), false, HashMap::new()),
+        (match &handler.kind { ConfiguredHandlerKind::Command { command, .. } => command.clone(), _ => unreachable!() }, true, HashMap::new()),
+        (match &handler.kind { ConfiguredHandlerKind::Command { command, .. } => command.clone(), _ => unreachable!() }, false, HashMap::from([("NODE_OPTIONS".to_string(), "injection".to_string())])),
+    ] {
+        let mut changed = handler.clone();
+        changed.kind = ConfiguredHandlerKind::Command { command, env, r#async: asynchronous };
+        assert!(!super::scikeel_required_guard_handlers(&[changed]));
+    }
+}
