[Unit]
Description=SciKeel bounded tenant sandbox launcher
After=network.target
ConditionPathExists=/etc/scikeel/sandbox-host.json

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=60s
ExecStart=/usr/local/lib/scikeel/osd-sandbox-host --config /etc/scikeel/sandbox-host.json
User=root
Group=root
UMask=0077
RuntimeDirectory=scikeel
RuntimeDirectoryMode=0755
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/scikeel /run/netns /var/lib/scikeel/launcher
ReadWritePaths=-/var/lib/scikeel/production-launcher -/var/lib/scikeel/tenant-data
ReadWritePaths=-/var/lib/scikeel/fixture-data -/srv/osd/platform/workers/instances -/srv/osd/platform/cli-runtime/users
ReadWritePaths=-/opt/open-science-desktop/.deploy/platform-data/workers/instances -/opt/open-science-desktop/.deploy/platform-data/cli-runtime/users
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# systemd blocks openat2 when RestrictSUIDSGID=yes; secure descriptor opening is required.
# Tenant mounts remain nosuid, with no capabilities and no-new-privileges.
RestrictSUIDSGID=no
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_SYS_CHROOT CAP_NET_RAW CAP_SYS_PTRACE
MemoryHigh=128M
MemoryMax=192M
MemorySwapMax=64M
TasksMax=32
CPUQuota=25%
KillMode=control-group
TimeoutStopSec=10s
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
