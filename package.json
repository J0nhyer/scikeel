{
  "name": "ai4s-workbench",
  "version": "0.5.2",
  "private": true,
  "description": "SciKeel \u2014 a model-agnostic AI research workbench served in the browser.",
  "license": "MIT",
  "scripts": {
    "platform:deps-lock": "node scripts/dev/safe-desktop-task.mjs platform-deps-lock",
    "platform:deps-install": "node scripts/dev/safe-desktop-task.mjs platform-deps-install",
    "dev": "pnpm --filter @ai4s/web dev",
    "build": "pnpm --filter @ai4s/web build",
    "test": "pnpm --filter @ai4s/web test",
    "platform:test": "pnpm --filter @ai4s/platform test",
    "platform:start": "pnpm --filter @ai4s/platform start",
    "typecheck": "pnpm --filter @ai4s/web typecheck",
    "lint": "pnpm --filter @ai4s/web lint",
    "sandbox:core:test": "node scripts/dev/safe-desktop-task.mjs core-test",
    "sandbox:core:check": "node scripts/dev/safe-desktop-task.mjs core-check",
    "sandbox:probe": "node scripts/dev/safe-desktop-task.mjs sandbox-probe",
    "sandbox:image:stage": "node scripts/dev/safe-desktop-task.mjs sandbox-image-stage",
    "sandbox:core:build": "node scripts/dev/safe-desktop-task.mjs core-build",
    "sandbox:network:test": "node scripts/dev/safe-desktop-task.mjs sandbox-network-test",
    "sandbox:mirror:lock": "node scripts/dev/safe-desktop-task.mjs sandbox-mirror-lock",
    "sandbox:mirror:prepare": "node scripts/dev/safe-desktop-task.mjs sandbox-mirror-prepare",
    "sandbox:mirror:probe": "node scripts/dev/safe-desktop-task.mjs sandbox-mirror-probe",
    "sandbox:mirror:install": "node scripts/dev/safe-desktop-task.mjs sandbox-mirror-install",
    "sandbox:migrate": "node scripts/dev/safe-desktop-task.mjs sandbox-migrate",
    "sandbox:storage:prepare": "node scripts/dev/safe-desktop-task.mjs sandbox-storage-prepare",
    "sandbox:host:prepare": "node scripts/dev/safe-desktop-task.mjs sandbox-host-prepare",
    "release:test": "node scripts/dev/safe-desktop-task.mjs release-test",
    "web:build": "pnpm --filter @ai4s/web web:build",
    "web:release": "node scripts/dev/web-release.mjs",
    "live:maintenance": "node scripts/dev/live-maintenance.mjs",
    "release:worker": "node scripts/dev/safe-desktop-task.mjs release --guarded",
    "runtime:title:prepare": "node scripts/dev/safe-desktop-task.mjs opencode-title-prepare",
    "runtime:title:test": "node scripts/dev/safe-desktop-task.mjs opencode-title-test",
    "runtime:title:build": "node scripts/dev/safe-desktop-task.mjs opencode-title-build",
    "runtime:title:check": "node scripts/dev/safe-desktop-task.mjs opencode-title-check",
    "runtime:title:acceptance": "node scripts/dev/safe-desktop-task.mjs opencode-title-acceptance",
    "runtime:codex:build": "node scripts/dev/safe-desktop-task.mjs codex-guard-build",
    "web:publish": "node scripts/dev/web-publish.mjs",
    "platform:title:live": "node scripts/dev/safe-desktop-task.mjs platform-title-live",
    "web:recovery:live": "node scripts/dev/safe-desktop-task.mjs web-recovery-live",
    "web:projects:live": "node scripts/dev/safe-desktop-task.mjs web-projects-live",
    "web:files:live": "node scripts/dev/safe-desktop-task.mjs web-files-live"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.4.0",
  "//overrides": {
    "security": "Patched transitive floors for brace-expansion (GHSA-rgw5-rvv9-x895), js-yaml (GHSA-5p4m-2wfm-xmqj) and nanoid (GHSA-2v37-7h3g-55p8, reached through postcss). Keep each override on its existing major line until the dependency tree resolves a safe version without help."
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18"
    }
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "esbuild": "^0.28.1"
  }
}
