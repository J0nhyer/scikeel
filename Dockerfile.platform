FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g pnpm@9.4.0

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/desktop/package.json apps/desktop/package.json
COPY packages/sdk/package.json packages/sdk/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY services/platform/package.json services/platform/package.json
COPY services/sandbox-backend/package.json services/sandbox-backend/package.json
RUN pnpm install --frozen-lockfile --filter @ai4s/platform...

COPY services/platform services/platform
COPY packages/sdk packages/sdk
COPY packages/shared packages/shared
COPY runtime/sandbox runtime/sandbox
COPY runtime/skills runtime/skills
COPY runtime/fonts runtime/fonts

ENV NODE_ENV=production
EXPOSE 4790
CMD ["node", "services/platform/src/main.mjs"]
