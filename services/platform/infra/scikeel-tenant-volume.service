[Unit]
Description=SciKeel reserved quota-backed tenant volume
After=local-fs.target
Before=scikeel-sandbox-host.service osd-platform.service
ConditionPathExists=/var/lib/scikeel/tenant-quota.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/local/lib/scikeel/prepare-tenant-volume.py
User=root
Group=root
UMask=0077
MemoryMax=96M
MemorySwapMax=32M
TasksMax=16
CPUQuota=50%
TimeoutStartSec=60s

[Install]
WantedBy=multi-user.target
