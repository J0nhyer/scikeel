[Unit]
Description=SciKeel disposable public Python package mirror
After=network-online.target
After=scikeel-package-mirror-volume.service
Requires=scikeel-package-mirror-volume.service
Wants=network-online.target
RequiresMountsFor=/var/lib/scikeel/package-mirror
ConditionPathExists=/var/lib/scikeel/package-mirror/data/.nodeinfo

[Service]
User=scikeel-mirror
Group=scikeel-mirror
ExecStart=/usr/lib/scikeel/mirror/bin/devpi-server --serverdir /var/lib/scikeel/package-mirror/data --host 127.0.0.1 --port 3141 --threads 4 --connection-limit 32 --request-timeout 60 --restrict-modify root --secretfile /var/lib/scikeel/package-mirror/data/.secret --argon2-memory-cost 65536 --argon2-parallelism 1 --argon2-time-cost 3
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M
TasksMax=64
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/scikeel/package-mirror
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
TimeoutStopSec=10s
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
