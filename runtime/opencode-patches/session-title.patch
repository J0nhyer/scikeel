+describe("SciKeel managed title transactions", () => {
+  it.instance("claims once and manual rename to the same title wins atomically", () =>
+    Effect.gen(function* () {
+      const previous = process.env.SCIKEEL_SESSION_TITLE_POLICY
+      process.env.SCIKEEL_SESSION_TITLE_POLICY = "conversation-v1"
+      try {
+        const session = yield* SessionNs.Service
+        const info = yield* session.create({ metadata: { existing: "keep" } })
+        const first = {
+          id: MessageID.ascending(), role: "user" as const, sessionID: info.id,
+          time: { created: Date.now() }, agent: "build", model: { providerID: "test", modelID: "model-a" },
+        } as SessionV1.User
+        yield* session.updateMessage(first)
+        yield* session.recordTitleMessage(first)
+        yield* session.recordTitleMessage({ ...first, id: MessageID.ascending(), model: { ...first.model, modelID: "model-later" as typeof first.model.modelID } })
+        const attempt = yield* session.claimTitleAttempt({ sessionID: info.id, first, triggerMessageID: first.id })
+        expect(attempt?.model).toEqual(first.model)
+        const duplicate = yield* session.claimTitleAttempt({ sessionID: info.id, first, triggerMessageID: first.id })
+        expect(duplicate).toBeUndefined()
+        yield* session.setMetadata({ sessionID: info.id, metadata: { newer: "preserve", scikeelSessionTitle: { version: 999 } } })
+        yield* session.setTitle({ sessionID: info.id, title: info.title })
+        expect(yield* session.finishTitleAttempt({ sessionID: info.id, attempt: attempt!, title: "Late generated title" })).toBe(false)
+        const renamed = yield* session.get(info.id)
+        expect(renamed.title).toBe(info.title)
+        expect(renamed.metadata?.newer).toBe("preserve")
+        expect(TitlePolicy.readJob(renamed.metadata)?.source).toBe("manual")
+        const fork = yield* session.fork({ sessionID: info.id })
+        expect(fork.metadata?.scikeelSessionTitle).toBeUndefined()
+        yield* session.remove(fork.id)
+        yield* session.remove(info.id)
+      } finally {
+        if (previous === undefined) delete process.env.SCIKEEL_SESSION_TITLE_POLICY
+        else process.env.SCIKEEL_SESSION_TITLE_POLICY = previous
+      }
+    }),
+  )
+  it.instance("publishes committed titles while explicit names and children stay ineligible", () =>
+    Effect.gen(function* () {
+      const previous = process.env.SCIKEEL_SESSION_TITLE_POLICY
+      process.env.SCIKEEL_SESSION_TITLE_POLICY = "conversation-v1"
+      try {
+        const session = yield* SessionNs.Service
+        const info = yield* session.create()
+        const first = {
+          id: MessageID.ascending(), role: "user" as const, sessionID: info.id,
+          time: { created: Date.now() }, agent: "build", model: { providerID: "test", modelID: "model-b" },
+        } as SessionV1.User
+        yield* session.updateMessage(first)
+        const attempt = yield* session.claimTitleAttempt({ sessionID: info.id, first, triggerMessageID: first.id })
+        const events = yield* EventV2Bridge.Service
+        const committed = yield* Deferred.make<string>()
+        const unsubscribe = yield* events.listen(event => Effect.gen(function* () {
+          if (event.type !== SessionNs.Event.Updated.type) return
+          const data = event.data as typeof SessionNs.Event.Updated.data.Type
+          if (data.info.id !== info.id || data.info.title !== "Research topic") return
+          const saved = yield* session.get(info.id)
+          Deferred.doneUnsafe(committed, Effect.succeed(saved.title))
+        }))
+        yield* Effect.addFinalizer(() => unsubscribe)
+        expect(yield* session.finishTitleAttempt({ sessionID: info.id, attempt: attempt!, title: "Research topic" })).toBe(true)
+        expect(yield* awaitDeferred(committed, "title notification before durable commit")).toBe("Research topic")
+        expect((yield* session.get(info.id)).title).toBe("Research topic")
+        const named = yield* session.create({ title: "Explicit" })
+        const child = yield* session.create({ parentID: info.id })
+        expect(named.metadata?.scikeelSessionTitle).toBeUndefined()
+        yield* session.setMetadata({ sessionID: named.id, metadata: { other: "keep", scikeelSessionTitle: TitlePolicy.initialJob() } })
+        const savedNamed = yield* session.get(named.id)
+        expect(savedNamed.metadata?.other).toBe("keep")
+        expect(savedNamed.metadata?.scikeelSessionTitle).toBeUndefined()
+        expect(child.metadata?.scikeelSessionTitle).toBeUndefined()
+        yield* session.remove(named.id)
+        yield* session.remove(info.id)
+      } finally {
+        if (previous === undefined) delete process.env.SCIKEEL_SESSION_TITLE_POLICY
+        else process.env.SCIKEEL_SESSION_TITLE_POLICY = previous
+      }
+    }),
+  )
+})
diff --git a/packages/opencode/test/session/title-policy.test.ts b/packages/opencode/test/session/title-policy.test.ts
new file mode 100644
index 0000000..5962e8e
--- /dev/null
+++ b/packages/opencode/test/session/title-policy.test.ts
@@ -0,0 +1,53 @@
+import assert from 'node:assert/strict';
+import { test } from 'bun:test';
+import { initialJob, captureFirstMessage, beginAttempt, finishAttempt, manualRename, titleText } from '../../src/session/title-policy';
+
+const first = { id: 'msg-a', model: { providerID: 'opencode', modelID: 'model-a', variant: 'high' } };
+const second = { id: 'msg-b', model: { providerID: 'opencode', modelID: 'model-b' } };
+test('capture keeps the first effective model and strips unrelated options', () => {
+  const job = captureFirstMessage(initialJob(), first);
+  assert.deepEqual(job.model, { providerID: 'opencode', modelID: 'model-a' });
+  assert.equal(job.firstMessageID, first.id);
+  assert.deepEqual(captureFirstMessage(job, second), job);
+});
+test('attempts are unique, bound to new messages, and exhausted after one retry', () => {
+  const captured = captureFirstMessage(initialJob(), first);
+  const running = beginAttempt(captured, first.id, 'run-1', 'attempt-1');
+  assert.equal(running.attempts, 1);
+  assert.equal(beginAttempt(running, second.id, 'run-1', 'duplicate'), undefined);
+  const failed = finishAttempt(running, 'attempt-1', running.revision, false);
+  assert.equal(beginAttempt(failed, first.id, 'run-1', 'replay'), undefined);
+  const retry = beginAttempt(failed, second.id, 'run-1', 'attempt-2');
+  assert.equal(retry.attempts, 2);
+  assert.deepEqual(retry.model, captured.model);
+  assert.equal(beginAttempt(finishAttempt(retry, 'attempt-2', retry.revision, false), 'msg-c', 'run-1', 'extra'), undefined);
+});
+test('restart may retry an interrupted initial attempt but cannot restart its retry', () => {
+  const running = beginAttempt(captureFirstMessage(initialJob(), first), first.id, 'old-run', 'initial');
+  assert.equal(beginAttempt(running, first.id, 'new-run', 'replay'), undefined);
+  const retry = beginAttempt(running, second.id, 'new-run', 'retry');
+  assert.equal(retry.attempts, 2);
+  assert.equal(beginAttempt(retry, 'msg-c', 'third-run', 'extra'), undefined);
+});
+test('manual rename invalidates completion even without a visible string change', () => {
+  const job = beginAttempt(captureFirstMessage(initialJob(), first), first.id, 'run', 'attempt');
+  const manual = manualRename(job);
+  assert.equal(manual.source, 'manual');
+  assert.equal(manual.revision, job.revision + 1);
+  assert.equal(finishAttempt(manual, job.attemptID, job.revision, true), undefined);
+  assert.equal(beginAttempt(manual, second.id, 'run', 'extra'), undefined);
+  assert.equal(finishAttempt(job, 'foreign', job.revision, true), undefined);
+  assert.equal(finishAttempt(job, job.attemptID, job.revision + 1, true), undefined);
+});
+test('successful attempts never retitle on a later model selection', () => {
+  const running = beginAttempt(captureFirstMessage(initialJob(), first), first.id, 'run', 'attempt');
+  const done = finishAttempt(running, 'attempt', running.revision, true);
+  assert.equal(done.source, 'automatic');
+  assert.equal(done.status, 'completed');
+  assert.equal(beginAttempt(done, second.id, 'run', 'retitle'), undefined);
+});
+test('cleaned titles preserve upstream length limits and reject empty output', () => {
+  assert.equal(titleText('<think>private reasoning</think>\n  My topic\nignored'), 'My topic');
+  assert.equal(titleText('a'.repeat(120)).length, 100);
+  assert.equal(titleText(' \n <think>nothing</think>'), undefined);
+});
